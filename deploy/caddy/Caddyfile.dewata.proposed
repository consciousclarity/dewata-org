# proposed private Caddy configuration for dewata.org
#
# this is the next-version of /opt/dewata.online/deploy/caddy/Caddyfile.dewata
# with a new @apex host matcher added.
#
# route ordering matters: every named handle ('@apex', '@api', ...) is
# tested in declaration order against the inbound request.  the catch-all
# ('handle { ... 503 ... }') at the end matches anything that falls
# through.  we put @apex BEFORE the catch-all so the apex landing page is
# not intercepted by the 503 default.
#
# IMPORTANT: do not deploy this file until reviewed and approved.  the
# existing /opt/dewata.online/deploy/caddy/Caddyfile.dewata continues
# to serve the api/bci/protocol/datasets vhosts in production until
# the patch below is accepted and applied.

{
    email alex_aguilar@gmx.ch
    admin off
}

:8443 {
    # cloudflare has already terminated TLS at its edge and forwards via
    # HTTP/2 to this origin over its private backbone.  we accept
    # plaintext on :8443 and route to specific vhosts.
    log {
        output file /opt/dewata.online/deploy/logs/caddy-private.log {
            roll_size 50mb
            roll_keep 3
        }
    }

    # === apex (dewata.org landing page) ===
    # served as static files from the versioned release directory.
    # the directory is *append-only*: new versions land in
    # /opt/dewata.online/deploy/www/dewata-org/v<MAJOR>.<MINOR>.<PATCH>/
    # the symlink "current" always points to the active version, but
    # this Caddyfile paths the active version directly so a rollback
    # is a single config reload.
    @apex host dewata.org

    handle @apex {
        root * /opt/dewata.online/deploy/www/dewata-org/v0.1.0-pre1
        encode gzip zstd
        file_server
    }

    # === api.dewata.org ===
    @api host api.dewata.org
    handle @api {
        reverse_proxy 127.0.0.1:8765
    }

    # === bci.dewata.org (cultural index, post-phase-3) ===
    @bci host bci.dewata.org
    handle @bci {
        # placeholder until phase 3 lands
        respond "BCI not yet shipped (v0.1.0 stays API-only)\n" 503
    }

    # === protocol.dewata.org (DSP spec site) ===
    @protocol host protocol.dewata.org
    handle @protocol {
        respond "DSP protocol site not yet shipped (v0.1.0)\n" 503
    }

    # === datasets.dewata.org (signed snapshots) ===
    @datasets host datasets.dewata.org
    handle @datasets {
        respond "Snapshot publication not yet shipped (v0.1.0)\n" 503
    }

    # === catch-all: anything else on *.dewata.org returns 503 ===
    # IMPORTANT: this is the LAST handle.  apex/api/bci/protocol/datasets
    # are matched first; if none match, this fires.
    handle {
        respond "Dewata.org subdomain not yet shipped (v0.1.0 — only api.dewata.org and dewata.org are live)\n" 503
    }
}

# No plain-text listener on :8080 — cloudflare "Full (strict)" TLS mode
# requires TLS at the origin.  for debugging without TLS, curl
# 127.0.0.1:8443 directly.
