# private Caddy configuration for dewata.org
#
# this caddy listens on :8443 and routes requests for *.dewata.org to
# specific vhosts.  it is distinct from the host's /etc/caddy/Caddyfile
# (which serves *.nusa.business and friends on :80/:443) and runs as a
# separate systemd unit (dewata-caddy.service).
#
# cloudflare terminates TLS at its edge and forwards via HTTP/2 over
# its private backbone.  this caddy accepts plaintext on :8443.
#
# route ordering matters: every named handle ('@apex', '@wiki', ...)
# is tested in declaration order against the inbound request.  the
# catch-all ('handle { ... 503 ... }') at the end matches anything
# that falls through.
#
# production deployment notes:
#   - this file has been live since 2026-09-17 (first load) / 2026-09-19
#     (full route set with apex + wiki handlers).  the previous commit
#     point c80d78a did not include @apex or @wiki handlers — they were
#     added in working-tree and survived a failed reload on 2026-09-17,
#     landing in production on next systemd restart.
#   - the apex handler reads its release directory from the
#     DEWATA_RELEASE_ROOT environment variable, defaulting to
#     v0.1.0-pre1.
#   - the wiki handler reads its release directory from the
#     DEWATA_WIKI_RELEASE_ROOT environment variable, defaulting to
#     the latest named release.  on deploy, set
#     DEWATA_WIKI_RELEASE_ROOT=/opt/dewata.online/deploy/www/wiki/<new>
#     and run `systemctl restart dewata-caddy.service` (NOT reload — see
#     deploy/runbook/caddy-reload-policy.md).  this avoids the failure
#     mode where a new wiki release is staged but the Caddyfile points at
#     the previous one.  env-var values are expanded at config-load time
#     (ExecStart), not at reload time, so restart is required to pick up
#     a new env-var value.
#   - DEWATA_LOG_FILE overrides the access log path.
#   - to roll back a release, change the env var to the previous
#     release directory and restart dewata-caddy.service — no Caddyfile
#     edit required.  there is no reload path on this unit; reload is
#     disabled because it would silently reconfigure the host Caddy on
#     :2019 (see deploy/runbook/caddy-reload-policy.md).
{
	# cloudflare terminates TLS at its edge; this Caddy accepts
	# plaintext on :8443 over cloudflared's private backbone.  We
	# explicitly disable auto-HTTPS so caddy does not try to acquire
	# certificates or bind :80/:443 on this host (the host Caddy on
	# :80/:443 is a different process owned by the OS package).
	auto_https off
	email alex_aguilar@gmx.ch
	admin off
}

:8443 {
	# cloudflare has already terminated TLS at its edge and forwards via
	# HTTP/2 to this origin over its private backbone.  we accept
	# plaintext on :8443 and route to specific vhosts.
	log {
		output file {$DEWATA_LOG_FILE:/opt/dewata.online/deploy/logs/caddy-private.log} {
			roll_size 50mb
			roll_keep 3
		}
	}

	# === apex (dewata.org landing page) ===
	# served as static files from the versioned release directory.
	# the directory is *append-only*: new versions land in
	# /opt/dewata.online/deploy/www/dewata-org/v<MAJOR>.<MINOR>.<PATCH>/
	# DEWATA_RELEASE_ROOT points at the active version; rollback is a
	# single env-var change + `systemctl restart dewata-caddy.service`
	# (NOT reload — see deploy/runbook/caddy-reload-policy.md).
	@apex host dewata.org

	handle @apex {
		root * {$DEWATA_RELEASE_ROOT:/opt/dewata.online/deploy/www/dewata-org/v0.1.0-pre1}
		encode gzip zstd
		file_server
	}

	# === wiki.dewata.org (static multilingual knowledge base) ===
	# versioned, immutable release built from dewata-org main.
	# DEWATA_WIKI_RELEASE_ROOT points at the active release; on
	# deploy, change the env var to the new release directory and
	# restart dewata-caddy.service (NOT reload — see
	# deploy/runbook/caddy-reload-policy.md).  do not hardcode the
	# release path here — hardcoding is the failure mode that left
	# wiki.dewata.org serving cf23840-r3 for three days after
	# 33f3142-r1 was staged.
	@wiki host wiki.dewata.org
	handle @wiki {
		root * {$DEWATA_WIKI_RELEASE_ROOT:/opt/dewata.online/deploy/www/wiki/b9eb4d9-r1}
		encode gzip zstd
		header Cache-Control "public, max-age=600, must-revalidate"
		file_server
	}

	# === api.dewata.org ===
	@api host api.dewata.org
	handle @api {
		reverse_proxy 127.0.0.1:8765
	}

	# === bci.dewata.org (cultural index, post-phase-3) ===
	@bci host bci.dewata.org
	handle @bci {
		# placeholder until phase 3 lands
		respond "BCI not yet shipped (v0.1.0 stays API-only)\n" 503
	}

	# === protocol.dewata.org (DSP spec site) ===
	@protocol host protocol.dewata.org
	handle @protocol {
		respond "DSP protocol site not yet shipped (v0.1.0)\n" 503
	}

	# === datasets.dewata.org (signed snapshots) ===
	@datasets host datasets.dewata.org
	handle @datasets {
		respond "Snapshot publication not yet shipped (v0.1.0)\n" 503
	}

	# === catch-all: anything else on *.dewata.org returns 503 ===
	# IMPORTANT: this is the LAST handle.  apex/wiki/api/bci/protocol/
	# datasets are matched first; if none match, this fires.
	handle {
		respond "Dewata.org subdomain not yet shipped (v0.1.0 — only api.dewata.org and dewata.org are live)\n" 503
	}
}

# No plain-text listener on :8080 — cloudflare "Full (strict)" TLS mode
# requires TLS at the origin.  for debugging without TLS, curl
# 127.0.0.1:8443 directly.
