# /opt/dewata.online/deploy/dns/.env.dewata.online.template
# Copy to /root/.env.dewata.online, chmod 600.
# This is the canonical credentials file for Dewata DNS + deployment.
# Read on every command invocation; never echoed in chat.

# cloudflare zone for dewata.org
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# github: read-only PAT or fine-grained token (optional, for git ops)
GITHUB_REPO=consciousclarity/dewata-online
GITHUB_DEPLOY_KEY=/root/.ssh/github_deploy

# hostinger target (where api/map/data live)
HOSTINGER_IP=
HOSTINGER_SSH_USER=

# what namecheap / cloudflare do for dewata.online (we keep parked)
DEWATA_LIVE_DOMAIN=dewata.org
DEWATA_LEGACY_DOMAIN=dewata.online

# signing key for daily signed snapshots (generated once)
SNAPSHOT_SIGNING_KEY=
