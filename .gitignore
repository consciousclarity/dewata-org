# python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.pytest_cache/
*.egg-info/

# generated — do NOT commit
**/conformance/*.json
**/conformance/*.jsonl
# EXCEPTION: STATUS.json is the canonical corpus-evidence-status
# registry (PROTOCOL v1.0 §2.7). It is metadata, not a generated
# corpus, and must be tracked. Narrow re-negation pattern: list the
# specific canonical metadata file as an exception. Future agents
# can simply `git add` the file without needing `-f`.
!/phase-1/conformance/STATUS.json
src/dewatacalendar/_version.py

# secrets — keep out of repo
.env*
*.env
rootpass*
*.pg.password
!/.env.*.template
!/deploy/dns/.env.dewata.online.template

# logs
*.log
logs/

# editor
.idea/
.vscode/
*.swp
.DS_Store

# build
build/
dist/

# deploy artifacts — generated, append-only, on disk by deploy convention
# not source.  keeping these untracked is a decision, not an accident:
# `git status` will not flag them as untracked if this rule is present.
# the wiki release directories (deploy/www/wiki/<sha>-r<n>/) and the
# operator-log snapshots (deploy/atomic/<timestamp>-pre-.../) are both
# regenerated on every deploy and have no historical value in git.
deploy/atomic/
deploy/www/

# mkdocs default site-dir (relative to wiki/mkdocs.yml) — `mkdocs build`
# without --site-dir writes here.  this is leftover from a build run
# that did not specify --site-dir; never commit it.
wiki/deploy/
