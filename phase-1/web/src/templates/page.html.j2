<!doctype html>
<html lang="bal" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}} — dewata.org</title>
<meta name="robots" content="noindex,nofollow">
<meta name="description" content="Balinese Cultural Index — provisional, synthetic content only">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body class="page">
<header class="header" role="banner">
<div class="brand"><a href="/index.html" aria-label="home">dewata.org</a></div>
<nav class="i18n" aria-label="language switcher">
<a href="?lang=bal" aria-current="true">Basa Bali</a>
<a href="?lang=id">Bahasa Indonesia</a>
<a href="?lang=en">English</a>
</nav>
</header>

<main class="main" role="main">
<h1 class="title">{{title}}</h1>

<div class="provenance-banner">
<p><strong>{{label}}</strong></p>
<ul>
<li>computed: items generated by the engine.</li>
<li>registered: items inserted by an authorised actor.</li>
<li>predicted: items the engine expects to appear.</li>
<li>verified: items cross-checked against an independent source.</li>
</ul>
</div>

<section aria-labelledby="computed-heading">
<h2 id="computed-heading">computed</h2>
<ul class="computed-list">{{computed_list}}</ul>
</section>

<section aria-labelledby="registered-heading">
<h2 id="registered-heading">registered</h2>
<ul class="registered-list">{{registered_list}}</ul>
</section>

<section aria-labelledby="predictions-heading">
<h2 id="predictions-heading">predictions</h2>
<ul class="predictions-list">{{predictions_list}}</ul>
</section>

<section aria-labelledby="verified-heading">
<h2 id="verified-heading">verified</h2>
<ul class="verified-list">{{verified_list}}</ul>
</section>
</main>

<footer class="footer" role="contentinfo">
<p>content language: Basa Bali (primary) · Bahasa Indonesia (secondary) · English (academic only)</p>
<p>policy marker: <strong>provisional</strong> — content is synthetic pending customary sign-off</p>
<p>no advertising · no location tracking · no directions · no booking</p>
<p><a href="/about.html">about this site</a> · <a href="/transparency.html">transparency</a></p>
</footer>
</body>
</html>
