      "Dasawara": {
        "formula": "(urip Pancawara + urip Saptawara + 1) / 10",
        "remainder_to_name": {
          "1": "Pandita",
          "2": "Pati",
          "3": "Suka",
          "4": "Duka",
          "5": "Sri",
          "6": "Manuh",
