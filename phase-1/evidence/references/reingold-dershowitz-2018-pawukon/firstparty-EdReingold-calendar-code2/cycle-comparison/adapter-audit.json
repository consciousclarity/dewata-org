      "Dwiwara": {
        "formula": "urip Pancawara + urip Saptawara",
        "rule": "odd = Pepet; even = Menga"
      },
      "Ekawara": {
        "rule": "urip Pancawara + urip Saptawara",
        "details": "odd = Luang; even = empty"
